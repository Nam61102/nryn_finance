# ── NRYN Finance backend ─────────────────────────────────────────────
# FATAL if missing — the server refuses to start without these.
MONGO_URI=mongodb://127.0.0.1:27017/nryn_finance
JWT_SECRET=
PORT=4200

# ── Optional (warn-only). Missing → the affected route answers 503 ──
# LLM fallback is OFF by default: regex-only parsing, unmatched messages
# land in "Needs review" instead of being sent to a third party.
LLM_FALLBACK_ENABLED=false
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Gmail (phase 2 — not required for v1 SMS ingest)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4200/api/gmail/oauth/callback

# Ops
TZ_APP=Asia/Kolkata
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082
JWT_EXPIRES_IN=30d
LOG_LEVEL=dev
