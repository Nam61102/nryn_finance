# ── NRYN Finance mobile ──────────────────────────────────────────────
# IMPORTANT: this MUST be your computer's LAN IP, not localhost.
# "localhost" on the phone means the phone itself, so the app will hang.
#   macOS : ipconfig getifaddr en0
#   Linux : hostname -I | awk '{print $1}'
#   Windows: ipconfig  → IPv4 Address
# After changing this file you MUST restart with:  npx expo start -c
# Running in the BROWSER (npm run web)? http://localhost:4200 is correct.
# Running on the PHONE? It must be the LAN IP below.
EXPO_PUBLIC_API_URL=http://localhost:4200

# Read the SMS inbox from this many days back on first run (§3.1).
EXPO_PUBLIC_BACKFILL_DAYS=180

# Upload batch size — the server rejects anything over 200.
EXPO_PUBLIC_BATCH_SIZE=200
